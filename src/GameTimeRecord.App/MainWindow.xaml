<Window x:Class="GameTimeRecord.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:GameTimeRecord.App.Converters"
        Title="游戏时间记录"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:OptionalTextJoinConverter x:Key="OptionalTextJoinConverter" />

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#865B58" />
            <Setter Property="BorderBrush" Value="#E5D8D6" />
            <Setter Property="Background" Value="#FCFAFA" />
        </Style>

        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="StatisticCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E7EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="OptionalMetadata" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="12,10"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F1F4F8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EBEFF3" />
                                <Setter Property="Foreground" Value="#40556B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E3E7ED"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="20,24">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="GAME TIME RECORD" />
                    <TextBlock Margin="0,5,0,18"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Text="我的游戏" />
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Margin="0,0,8,0"
                                Style="{StaticResource PrimaryButton}"
                                Click="AddGame_Click"
                                Content="＋ 新建游戏" />
                        <Button Grid.Column="1"
                                Margin="0,0,8,0"
                                Click="EditGame_Click"
                                Content="编辑"
                                IsEnabled="{Binding HasSelectedGame}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource DangerButton}"
                                Click="DeleteGame_Click"
                                Content="删除"
                                IsEnabled="{Binding HasSelectedGame}" />
                    </Grid>
                </StackPanel>

                <ListBox x:Name="GamesList"
                         Padding="0"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding Games}"
                         SelectionChanged="GamesList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{Binding Name}" />
                                <TextBlock Style="{StaticResource OptionalMetadata}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource OptionalTextJoinConverter}"
                                                      ConverterParameter=" · ">
                                            <Binding Path="Alias" />
                                            <Binding Path="Platform" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="32,28,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="{StaticResource TextBrush}"
                               FontSize="29"
                               FontWeight="SemiBold"
                               Text="{Binding SelectedGame.Name, TargetNullValue=请选择或新建游戏}" />
                    <TextBlock Style="{StaticResource OptionalMetadata}" FontSize="13">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource OptionalTextJoinConverter}"
                                          ConverterParameter=" · ">
                                <Binding Path="SelectedGame.Platform" />
                                <Binding Path="SessionStatus" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="11,6"
                        VerticalAlignment="Top"
                        Background="#E9EEF7"
                        CornerRadius="14">
                    <TextBlock Foreground="#34527A"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="本地记录" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,24" Orientation="Horizontal">
                <Button Margin="0,0,9,0"
                        MinWidth="108"
                        Style="{StaticResource PrimaryButton}"
                        Click="Start_Click"
                        Content="开始游戏"
                        IsEnabled="{Binding CanStart}" />
                <Button Margin="0,0,9,0"
                        Click="Pause_Click"
                        Content="暂停"
                        IsEnabled="{Binding IsPlaying}" />
                <Button Margin="0,0,9,0"
                        Click="Resume_Click"
                        Content="恢复"
                        IsEnabled="{Binding IsPaused}" />
                <Button Click="End_Click"
                        Content="结束游戏"
                        IsEnabled="{Binding CanEnd}" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatisticCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource CompactButton}"
                                    Click="CopyTotal_Click"
                                    Content="复制" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="累计时长（秒）" />
                        </DockPanel>
                        <TextBlock Grid.Row="1"
                                   Margin="0,11,0,0"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Text="{Binding TotalSeconds}" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StatisticCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource CompactButton}"
                                    Click="CopyCount_Click"
                                    Content="复制" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="游玩次数" />
                        </DockPanel>
                        <TextBlock Grid.Row="1"
                                   Margin="0,11,0,0"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Text="{Binding PlayCount}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatisticCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource CompactButton}"
                                    Click="CopyFirst_Click"
                                    Content="复制"
                                    IsEnabled="{Binding CanCopyFirstPlayedAt}" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="首次游玩" />
                        </DockPanel>
                        <TextBlock Grid.Row="1"
                                   Margin="0,14,0,0"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding FirstPlayedAt}" />
                    </Grid>
                </Border>

                <Border Grid.Column="3" Margin="0" Style="{StaticResource StatisticCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource CompactButton}"
                                    Click="CopyLast_Click"
                                    Content="复制"
                                    IsEnabled="{Binding CanCopyLastPlayedAt}" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="最后游玩" />
                        </DockPanel>
                        <TextBlock Grid.Row="1"
                                   Margin="0,14,0,0"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding LastPlayedAt}" />
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="HistoryPanel"
                    Grid.Row="3"
                    Padding="18"
                    Background="White"
                    BorderBrush="#E2E7EF"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Foreground="{StaticResource TextBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="游玩记录详情" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   Text="按游玩次数整理，每次操作均精确到秒" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SessionTimeline"
                                          ItemsSource="{Binding PlaySessionGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,0,0,12"
                                                  HorizontalContentAlignment="Stretch"
                                                  IsExpanded="{Binding IsExpanded, Mode=OneTime}">
                                            <Expander.Header>
                                                <StackPanel Margin="2,3,8,3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold">
                                                            <Run Text="第 " />
                                                            <Run Text="{Binding SessionNumber, Mode=OneWay}" />
                                                            <Run Text=" 次游玩" />
                                                        </TextBlock>
                                                        <Border Margin="10,0,0,0"
                                                                Padding="9,4"
                                                                VerticalAlignment="Center"
                                                                CornerRadius="10">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#EEF1F4" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="正在游玩">
                                                                            <Setter Property="Background" Value="#E8F0EC" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="已暂停">
                                                                            <Setter Property="Background" Value="#F3EFE7" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Foreground="#5D6977"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding Status}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Margin="0,6,0,0"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               FontSize="12">
                                                        <Run Text="{Binding StartedAt, Mode=OneWay}" />
                                                        <Run Text="  ·  有效时长 " />
                                                        <Run Text="{Binding DurationText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Expander.Header>

                                            <Border Margin="0,10,0,0"
                                                    Padding="16,10"
                                                    Background="#FAFBFC"
                                                    BorderBrush="#E7EAEF"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <ItemsControl ItemsSource="{Binding Events}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid MinHeight="54">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="32" />
                                                                    <ColumnDefinition Width="90" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <Border x:Name="TimelineLine"
                                                                        Grid.Column="0"
                                                                        Width="1"
                                                                        Margin="0,27,0,-27"
                                                                        HorizontalAlignment="Center"
                                                                        Background="#D8DDE4" />
                                                                <Border x:Name="TimelineNode"
                                                                        Grid.Column="0"
                                                                        Width="10"
                                                                        Height="10"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Background="#718197"
                                                                        CornerRadius="5" />
                                                                <TextBlock Grid.Column="1"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextBrush}"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding Action}" />
                                                                <TextBlock Grid.Column="2"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="#556170"
                                                                           FontFamily="Cascadia Mono, Consolas"
                                                                           FontSize="13"
                                                                           Text="{Binding LocalTime}" />
                                                                <Button Grid.Column="3"
                                                                        MinHeight="28"
                                                                        Padding="10,3"
                                                                        VerticalAlignment="Center"
                                                                        Tag="{Binding}"
                                                                        Click="EditEvent_Click"
                                                                        Content="修改" />
                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                    <Setter TargetName="TimelineLine" Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Action}" Value="暂停">
                                                                    <Setter TargetName="TimelineNode" Property="Background" Value="#A08E70" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Action}" Value="结束">
                                                                    <Setter TargetName="TimelineNode" Property="Background" Value="#5F6874" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Padding="16,24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="还没有游玩记录">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=SessionTimeline}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <TextBlock x:Name="NoticeText"
                       Grid.Row="4"
                       Margin="0,12,0,0"
                       HorizontalAlignment="Right"
                       Foreground="#16794A"
                       FontWeight="SemiBold" />
        </Grid>
    </Grid>
</Window>
