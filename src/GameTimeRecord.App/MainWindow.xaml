<Window x:Class="GameTimeRecord.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:GameTimeRecord.App.Converters"
        Title="游戏时间记录"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:OptionalTextJoinConverter x:Key="OptionalTextJoinConverter" />

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#865B58" />
            <Setter Property="BorderBrush" Value="#E5D8D6" />
            <Setter Property="Background" Value="#FCFAFA" />
        </Style>

        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="StatisticCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E7EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="OptionalMetadata" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="12,10"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F1F4F8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EBEFF3" />
                                <Setter Property="Foreground" Value="#40556B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#F6F7F9" />
            <Setter Property="BorderBrush" Value="#E7EAEF" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFBFC" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F5F7" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EAEFF3" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E3E7ED"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="20,24">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="GAME TIME RECORD" />
                    <TextBlock Margin="0,5,0,18"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Text="我的游戏" />
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Margin="0,0,8,0"
                                Style="{StaticResource PrimaryButton}"
                                Click="AddGame_Click"
                                Content="＋ 新建游戏" />
                        <Button Grid.Column="1"
                                Margin="0,0,8,0"
                                Click="EditGame_Click"
                                Content="编辑"
                                IsEnabled="{Binding HasSelectedGame}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource DangerButton}"
                                Click="DeleteGame_Click"
                                Content="删除"
                                IsEnabled="{Binding HasSelectedGame}" />
                    </Grid>
                </StackPanel>

                <ListBox x:Name="GamesList"
                         Padding="0"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding Games}"
                         SelectionChanged="GamesList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{Binding Name}" />
                                <TextBlock Style="{StaticResource OptionalMetadata}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource OptionalTextJoinConverter}"
                                                      ConverterParameter=" · ">
                                            <Binding Path="Alias" />
                                            <Binding Path="Platform" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="32,28,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="{StaticResource TextBrush}"
                               FontSize="29"
                               FontWeight="SemiBold"
                               Text="{Binding SelectedGame.Name, TargetNullValue=请选择或新建游戏}" />
                    <TextBlock Style="{StaticResource OptionalMetadata}" FontSize="13">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource OptionalTextJoinConverter}"
                                          ConverterParameter=" · ">
                                <Binding Path="SelectedGame.Platform" />
                                <Binding Path="SessionStatus" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="11,6"
                        VerticalAlignment="Top"
                        Background="#E9EEF7"
                        CornerRadius="14">
                    <TextBlock Foreground="#34527A"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="本地记录" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,24" Orientation="Horizontal">
                <Button Margin="0,0,9,0"
                        MinWidth="108"
                        Style="{StaticResource PrimaryButton}"
                        Click="Start_Click"
                        Content="开始游戏"
                        IsEnabled="{Binding CanStart}" />
                <Button Margin="0,0,9,0"
                        Click="Pause_Click"
                        Content="暂停"
                        IsEnabled="{Binding IsPlaying}" />
                <Button Margin="0,0,9,0"
                        Click="Resume_Click"
                        Content="恢复"
                        IsEnabled="{Binding IsPaused}" />
                <Button Margin="0,0,9,0"
                        Click="End_Click"
                        Content="结束游戏"
                        IsEnabled="{Binding CanEnd}" />
                <Button x:Name="HistoryButton"
                        Click="ToggleHistory_Click"
                        Content="游玩记录详情"
                        IsEnabled="{Binding HasSelectedGame}" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatisticCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource CompactButton}"
                                    Click="CopyTotal_Click"
                                    Content="复制" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="累计时长（秒）" />
                        </DockPanel>
                        <TextBlock Grid.Row="1"
                                   Margin="0,11,0,0"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Text="{Binding TotalSeconds}" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StatisticCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource CompactButton}"
                                    Click="CopyCount_Click"
                                    Content="复制" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="游玩次数" />
                        </DockPanel>
                        <TextBlock Grid.Row="1"
                                   Margin="0,11,0,0"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Text="{Binding PlayCount}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatisticCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource CompactButton}"
                                    Click="CopyFirst_Click"
                                    Content="复制"
                                    IsEnabled="{Binding CanCopyFirstPlayedAt}" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="首次游玩" />
                        </DockPanel>
                        <TextBlock Grid.Row="1"
                                   Margin="0,14,0,0"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding FirstPlayedAt}" />
                    </Grid>
                </Border>

                <Border Grid.Column="3" Margin="0" Style="{StaticResource StatisticCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource CompactButton}"
                                    Click="CopyLast_Click"
                                    Content="复制"
                                    IsEnabled="{Binding CanCopyLastPlayedAt}" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="最后游玩" />
                        </DockPanel>
                        <TextBlock Grid.Row="1"
                                   Margin="0,14,0,0"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding LastPlayedAt}" />
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="HistoryPanel"
                    Grid.Row="3"
                    Padding="18"
                    Background="White"
                    BorderBrush="#E2E7EF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Click="EditEvent_Click"
                                Content="修改所选时间" />
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource TextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="游玩记录详情" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12"
                                       Text="每次操作均按本机时区显示，精确到秒" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="EventsGrid"
                              Grid.Row="1"
                              AlternationCount="2"
                              AutoGenerateColumns="False"
                              Background="White"
                              BorderBrush="#E4E7EC"
                              BorderThickness="1"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              GridLinesVisibility="None"
                              IsReadOnly="True"
                              ItemsSource="{Binding PlayEvents}"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="130" Header="游玩次数">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,3"
                                                HorizontalAlignment="Left"
                                                Background="#EEF1F4"
                                                CornerRadius="10">
                                            <TextBlock Foreground="#5D6977"
                                                       FontSize="12"
                                                       FontWeight="SemiBold">
                                                <Run Text="第 " />
                                                <Run Text="{Binding SessionNumber, Mode=OneWay}" />
                                                <Run Text=" 次" />
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="130" Header="操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="ActionBadge"
                                                MinWidth="52"
                                                Padding="9,3"
                                                HorizontalAlignment="Left"
                                                Background="#EEF1F4"
                                                CornerRadius="10">
                                            <TextBlock x:Name="ActionText"
                                                       HorizontalAlignment="Center"
                                                       Foreground="#5D6977"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Action}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Action}" Value="开始">
                                                <Setter TargetName="ActionBadge" Property="Background" Value="#E9F1EE" />
                                                <Setter TargetName="ActionText" Property="Foreground" Value="#4D6C61" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Action}" Value="暂停">
                                                <Setter TargetName="ActionBadge" Property="Background" Value="#F4F0E8" />
                                                <Setter TargetName="ActionText" Property="Foreground" Value="#74664C" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Action}" Value="恢复">
                                                <Setter TargetName="ActionBadge" Property="Background" Value="#EAEFF3" />
                                                <Setter TargetName="ActionText" Property="Foreground" Value="#52677B" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Action}" Value="结束">
                                                <Setter TargetName="ActionBadge" Property="Background" Value="#F1ECEC" />
                                                <Setter TargetName="ActionText" Property="Foreground" Value="#705A59" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*" Header="记录时间">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="#3D4957"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="13"
                                                   Text="{Binding LocalTime}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <TextBlock x:Name="NoticeText"
                       Grid.Row="4"
                       Margin="0,12,0,0"
                       HorizontalAlignment="Right"
                       Foreground="#16794A"
                       FontWeight="SemiBold" />
        </Grid>
    </Grid>
</Window>
